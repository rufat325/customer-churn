# Generated data and trained artifacts are reproducible from source, so they
# are not tracked. The keepfiles preserve the directories themselves.
data/*
!data/.gitkeep

models/*
!models/.gitkeep

.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.env

# Saved container images. `docker save` writes these into the repo
# folder and they are far past GitHub's 100 MB limit.
*.tar
*.tar.gz

# Private keys must never be committed.
*.pem
